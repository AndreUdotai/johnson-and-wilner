<!doctype html>
<html class="no-js" lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title><%= title %> | JOHNSON AND WILNER LLP</title>
    <meta name="robots" content="noindex, follow">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Favicon -->
    <link rel="shortcut icon" type="image/png" href="/images/jw-favicon.png">

    <!-- CSS Files -->
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/fontawesome.css">
    <link rel="stylesheet" href="/css/flaticon.css">
    <link rel="stylesheet" href="/css/pbminfotech-base-icons.css">
    <link rel="stylesheet" href="/css/swiper.min.css">
    <link rel="stylesheet" href="/css/magnific-popup.css">
    <link rel="stylesheet" href="/css/themify-icons.css">
    <link rel="stylesheet" href="/css/shortcode.css">
    <link rel="stylesheet" href="/css/demo-5.css">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/aos.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">

    <!-- Revolution Slider -->
    <link rel="stylesheet" type="text/css" href="/revolution/rs6.css">
</head>
<body>

    <div class="page-wrapper">

        <%- include('../partials/navbar') %>

        <%- content %>

        <%- include('../partials/footer') %>

    </div>
    <!-- page wrapper End -->

    <!-- Search Overlay -->
    <div class="pbmit-search-overlay">
        <div class="pbmit-icon-close"></div>
        <div class="pbmit-search-outer">
            <div class="pbmit-form-title">Hi, How Can We Help You?</div>
            <div class="pbmit-search-logo">
                <img src="/images/homepage-8/logo.png" alt="Johnson & Wilner LLP">
            </div>
            <form class="pbmit-site-searchform" action="/search-bar" method="get">
                <input type="search" class="form-control field searchform-s" 
                       name="search_query" placeholder="Search Attorney, Blog Post, Policy Paper...">
                <button type="submit">
                    <i class="pbmit-base-icon-search"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- JS Files -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.waypoints.min.js"></script>
    <script src="/js/jquery.appear.js"></script>
    <script src="/js/numinate.min.js"></script>
    <script src="/js/swiper.min.js"></script>
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <script src="/js/circle-progress.js"></script>
    <script src="/js/aos.js"></script>
    <script src="/js/isotope.pkgd.min.js"></script>
    <script src="/js/scripts.js"></script>

    <!-- Revolution Slider JS -->
    <script src="/revolution/rslider.js"></script>
    <script src="/revolution/rbtools.min.js"></script>
    <script src="/revolution/rs6.min.js"></script>

    <script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>