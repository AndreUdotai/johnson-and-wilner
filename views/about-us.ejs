  <!-- Team Data & Search Script (Outside EJS content) -->

  <script>
    let teamMembers = [];

    // Load data (adjust path if needed)
    fetch('/js/data/team.js')
      .then(response => response.text())
      .then(text => {
        const match = text.match(/const teamMembers = ([\s\S]*?);/);
        if (match) {
          teamMembers = eval(match[1]);
          renderAttorneys();
        }
      })
      .catch(err => console.error(err));

    function renderAttorneys(filtered = null) {
      const grid = document.getElementById('attorneysGrid');
      grid.innerHTML = '';

      const toRender = filtered || teamMembers.filter(m => m.mainPartner === true);

      toRender.forEach(member => {
        const html = `
                <div class="col-md-6 col-lg-4 mb-4 attorney-card ${member.mainPartner ? 'main-partner' : ''}" data-name="${member.name}">
                    <a href="/attorney/${member.slug}" class="text-decoration-none">
                        <article class="pbmit-teambox-style-2">
                            <div class="pbmit-post-item">
                                <img src="${member.image}" class="img-fluid" alt="${member.name}">
                                <div class="pbmit-box-content">
                                    <h4 style="margin-top: 10px; font-size: 25px;">${member.name}</h4>
                                    
                                </div>
                                    <div class="pbmit-box-team-position">${member.role}</div>

                            </div>
                        </article>
                    </a>
                </div>
            `;
        grid.innerHTML += html;
      });
    }

    // Search
    const searchInput = document.getElementById('searchInput');

    function filterAttorneys() {
      const term = searchInput.value.toLowerCase().trim();
      if (term === '') {
        renderAttorneys();
      } else {
        const filtered = teamMembers.filter(m => m.name.toLowerCase().includes(term));
        renderAttorneys(filtered);
      }
    }

    searchInput.addEventListener('input', filterAttorneys);
    document.getElementById('attorneySearchForm').addEventListener('submit', e => {
      e.preventDefault();
      filterAttorneys();
    });
  </script>