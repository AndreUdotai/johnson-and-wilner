  <!-- Search Script -->
  <script>
    const searchInput = document.getElementById('searchInput');
    const attorneyCards = document.querySelectorAll('.attorney-card');

    function filterAttorneys() {
      const searchTerm = searchInput.value.toLowerCase().trim();

      attorneyCards.forEach(card => {
        const name = card.getAttribute('data-name').toLowerCase();
        if (searchTerm === '') {
          // Show ONLY main partners when search is empty
          card.style.display = card.classList.contains('main-partner') ? 'block' : 'none';
          // card.style.display = 'block';
        } else {
          // Show matching results when user is searching
          card.style.display = name.includes(searchTerm) ? 'block' : 'none';
        }
      });
    }

    // Live search as user types
    searchInput.addEventListener('input', filterAttorneys);

    // Also support form submit
    document.getElementById('attorneySearchForm').addEventListener('submit', function (e) {
      e.preventDefault();
      filterAttorneys();
    });

    // Initial load - show only main partners
    window.addEventListener('load', filterAttorneys);
  </script>
