<%- include('layouts/main', { 
    title: 'Publications',
    content: `
        <section class="publications-hero">
            <div class="container">
                <h4>PUBLICATIONS</h4>
                <h1>Insights at the Intersection of Law, Technology, and Business</h1>
                <p>Explore our latest publications, legal insights, policy updates, and thought leadership.</p>
            </div>
        </section>
<!--// Dynamically generate all publication cards from the shared publications dataset.-->
        <section class="publications-section">
            <div class="container">
                <div class="row">
                    ${publications.map(publication => `
                        <div class="col-lg-4 col-md-6 mb-4">
                            <a href="${publication.link}" target="_blank" rel="noopener noreferrer" class="publication-card">
                                <h3>${publication.title}</h3>
                                <div class="publication-date">${publication.date}</div>
                                <span class="publication-link">Read Publication →</span>
                            </a>
                        </div>
                    `).join('')}
                </div>
            </div>
        </section>
    `
}) %>