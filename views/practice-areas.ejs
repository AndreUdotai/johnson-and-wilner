<%- include('layouts/main', { title: 'Practice Areas' , content: ` <!-- Page Content -->

    <div class="page-content">
        <section class="section-md pbmit-bg-color-light">
            <div class="container">
                <div class="pbmit-heading-subheading text-center">
                    <h4 class="pbmit-subtitle">OUR EXPERTISE</h4>
                    <h2 class="pbmit-title">Practice Areas</h2>
                </div>

<!-- Dynamically generate Practice Area cards from the shared practice areas dataset.-->
                <div class="row">
                    ${practiceAreas.map(area => `
                        <div class="col-md-6 col-lg-4 mb-4">
                            <article class="pbmit-servicebox-style-2">
                                <div class="pbmit-post-item">
                                    <span class="pbmit-item-thumbnail">
                                        <span class="pbmit-item-thumbnail-inner">
                                            <img src="${area.image}" class="img-fluid" alt="${area.title}">
                                        </span>
                                    </span>

                                    <div class="pbmit-box-content">
                                        <div class="pbmit-box-content-inner">
                                            <div class="pbmit-pf-box-title">
                                                <div class="pbmit-box-category">
                                                    <a href="/practice-area/${area.id}">
                                                        ${area.category}
                                                    </a>
                                                </div>

                                                <h3>
                                                    <a href="/practice-area/${area.id}">
                                                        ${area.title}
                                                    </a>
                                                </h3>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        </div>
                    `).join('')}
                </div>
            </div>
        </section>

        <!-- ===========================================================
                Team Widget Displays four featured team members.
        =========================================================== -->
        <section class="section-md">
            <div class="container">

                <div class="pbmit-heading-subheading text-center">
                    <h4 class="pbmit-subtitle">OUR TEAM</h4>
                    <h2 class="pbmit-title">Global expertise in diverse areas of law</h2>
                </div>

                <div class="team-widget-grid">
                    ${teamMembers.map(member => `
                        <div class="team-widget-item">
                            <a href="/attorney/${member.slug}" class="team-widget-card">
                                <div class="team-widget-image">
                                    <img
                                        src="${member.image}"
                                        alt="${member.name}"
                                        class="img-fluid">
                                </div>

                                <div class="team-widget-content">
                                    <h4>${member.name}</h4>
                                    <p>${member.role}</p>
                                </div>
                            </a>
                        </div>

                    `).join('')}

                </div>

            </div>
        </section>

        <!-- Publications Start -->
        <!-- Practice Areas page Publications section showcasing the latest publications. -->
        <section class="home-publications-section">
            <div class="container">
                <div class="row align-items-center mb-5">
                    <div class="col-md-8">
                        <div class="pbmit-heading-subheading-style-2">
                            <h4 class="pbmit-subtitle">PUBLICATIONS</h4>
                            <h2 class="pbmit-title">Recent Publications</h2>
                        </div>
                    </div>
                </div>

                <!-- Dynamically display the three most recent publications on the Practice Areas page. -->
                <div class="row">
                    ${publications.map(publication => `
                        <div class="col-lg-4 col-md-6 mb-4">
                            <a href="${publication.link}" target="_blank" rel="noopener noreferrer" class="publication-card">
                                <h3>${publication.title}</h3>
                                <div class="publication-date">${publication.date}</div>
                                <span class="publication-link">Read Publication →</span>
                            </a>
                        </div>
                    `).join('')}
                </div>

                <div class="row">
                    <div class="col-12 text-end">
                        <a class="pbmit-btn pbmit-btn-global" href="/publications">
                            <span>View All Publications</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>
        <!-- Publications End -->
    </div>

    `
    }) %>