<%- include('layouts/main', { title: 'Practice Areas' , content: ` <!-- Page Content -->

    <div class="page-content">
        <section class="section-md pbmit-bg-color-light">
            <div class="container">
                <div class="pbmit-heading-subheading text-center">
                    <h4 class="pbmit-subtitle">OUR EXPERTISE</h4>
                    <h2 class="pbmit-title">Practice Areas</h2>
                </div>

<!-- Dynamically generate Practice Area cards from the shared practice areas dataset.-->
                <div class="row">
                    ${practiceAreas.map(area => `
                        <div class="col-md-6 col-lg-4 mb-4">
                            <article class="pbmit-servicebox-style-2">
                                <div class="pbmit-post-item">
                                    <span class="pbmit-item-thumbnail">
                                        <span class="pbmit-item-thumbnail-inner">
                                            <img src="${area.image}" class="img-fluid" alt="${area.title}">
                                        </span>
                                    </span>

                                    <div class="pbmit-box-content">
                                        <div class="pbmit-box-content-inner">
                                            <div class="pbmit-pf-box-title">
                                                <div class="pbmit-box-category">
                                                    <a href="/practice-area/${area.id}">
                                                        ${area.category}
                                                    </a>
                                                </div>

                                                <h3>
                                                    <a href="/practice-area/${area.id}">
                                                        ${area.title}
                                                    </a>
                                                </h3>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        </div>
                    `).join('')}
                </div>
            </div>
        </section>
    </div>

    `
    }) %>