<!-- Header Main Area -->
<header class="site-header header-style-8">
    <div class="container-fluid g-0">
        <div class="site-header-menu d-flex align-items-center">

            <!-- Logo -->
            <div class="site-branding">
                <h1 class="site-title">
                    <a href="/">
                        <img class="logo-img img-fluid" src="/images/logo-llp.png" alt="Johnson & Wilner LLP Logo">
                    </a>
                </h1>
            </div>

            <div class="pbmit-menu-topbararea flex-grow-1">
                <!-- Top Contact Bar -->
                <div class="pre-header">
                    <div class="pbmit-pre-header-inner">
                        <div class="container">
                            <div class="pbmit-table pbmit-pre-header-content">
                                <div class="pbmit-table-cell">
                                    <ul class="top-contact">
                                        <li>
                                            <i class="pbmit-base-icon-location-pin"></i>
                                            <span>Address: </span>Suite A10, Hawthorn Suites, 1 Uke Street, Garki 2 -
                                            FCT, Abuja
                                        </li>
                                    </ul>
                                </div>
                                <div class="pbmit-table-cell pbmit-align-right">
                                    <div class="pbmit-social-links-wrapper">
                                        <ul class="social-icons">
                                            <!-- <li class="pbmit-social-facebook"><a target="_blank" href="#"><i class="pbmit-base-icon-facebook"></i></a></li> -->
                                            <li class="pbmit-social-twitter"><a target="_blank" 
                                                    href="https://x.com/johnson_wilner"><i
                                                        class="fa-brands fa-x-twitter"></i></a></li>
                                            <li class="pbmit-social-linkedin"><a target="_blank"
                                                    href="https://linkedin.com/company/johnsonandwilner"><i
                                                        class="fa-brands fa-linkedin-in"></i></a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Navigation -->
                <div class="site-navigations d-flex justify-content-between">
                    <nav class="main-menu navbar-expand-xl navbar-light">
                        <div class="navbar-header">
                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                                data-bs-target="#pbmit-menu" aria-controls="pbmit-menu" aria-expanded="false">
                                <i class="pbmit-attorco-icon-bars"></i>
                            </button>
                        </div>

                        <div class="pbmit-mobile-menu-bg"></div>

                        <div class="collapse navbar-collapse clearfix" id="pbmit-menu">
                            <div class="pbmit-menu-wrap">
                                <ul class="navigation clearfix">
                                  <li class="<%= currentPath === '/' ? 'active' : '' %>"><a href="/">Home</a></li>

                                    <li class="<%= currentPath === '/about-us' ? 'active' : '' %>">
                                        <a href="/about-us">About Us</a>
                                    </li>

                                    <li class="<%= currentPath === '/practice-areas' ? 'active' : '' %>">
                                        <a href="/practice-areas">Practice Areas</a>
                                    </li>

                                    <li class="<%= currentPath === '/publications' ? 'active' : '' %>">
                                        <a href="/publications">Publications</a>
                                    </li>

                                    <li class="<%= currentPath === '/contacts' ? 'active' : '' %>">
                                        <a href="/contacts">Contacts</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </nav>

                    <!-- <div class="pbmit-right-side">
                        <a class="pbmit-btn pbmit-btn-outline" href="/contacts">
                            <span>CONSULTATION</span>
                        </a>
                    </div> -->
                </div>
            </div>

            <!-- Phone -->
            <div class="pbmit-header-left-area">
                <div class="pbmit-header-phone-wrap">
                    <a href="tel:+2348160051310">
                        <span class="pbmit-header-phone-wrap-inner">
                            <i class="pbmit-base-icon-phone-call-1"></i>
                            <span class="pbmit-phone-title">Have any Questions?</span>
                            <span class="pbmit-phone-number">+234 816 005 1310</span>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>